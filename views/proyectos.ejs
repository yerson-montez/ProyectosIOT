<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TECNOSYSTEM - Feria de Innovación y Tecnología IoT</title>
  <meta name="description" content="Descubre los mejores proyectos de Internet of Things (IoT) de TECNOSYSTEM - Universidad Nacional de Huancavelica">
  <meta name="keywords" content="IoT, Internet de las Cosas, proyectos, tecnología, innovación, TECNOSYSTEM, UNH, Huancavelica">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/img/favicon.png">
  
  <!-- CSS -->
  <link rel="stylesheet" href="/css/styles.css">
  
  <!-- Font Awesome para iconos -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    .tecnosystem-banner {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      color: white;
      padding: 15px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    
    .tecnosystem-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      animation: shine 3s infinite;
    }
    
    @keyframes shine {
      0% { left: -100%; }
      100% { left: 100%; }
    }
    
    .banner-content {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    
    .unh-logo {
      width: 50px;
      height: 50px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1e3c72;
      font-weight: bold;
    }
    
    .banner-text h2 {
      margin: 0;
      font-size: 1.4rem;
      font-weight: 700;
    }
    
    .banner-text p {
      margin: 0;
      font-size: 0.9rem;
      opacity: 0.9;
    }
    
    .event-date {
      background: rgba(255,255,255,0.2);
      padding: 10px 20px;
      border-radius: 25px;
      backdrop-filter: blur(10px);
    }
    
    .additional-filters {
      margin-top: 15px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }
    
    .innovartek-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: linear-gradient(45deg, #ff6b6b, #ee5a52);
      color: white;
      padding: 5px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: bold;
      box-shadow: 0 2px 10px rgba(238, 90, 82, 0.3);
    }
    
    .project-impact {
      background: linear-gradient(45deg, #4ecdc4, #44a08d);
      color: white;
      padding: 5px 10px;
      border-radius: 12px;
      font-size: 0.75rem;
      margin-top: 8px;
    }
    
    .regional-tag {
      background: linear-gradient(45deg, #667eea, #764ba2);
      color: white;
      padding: 3px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
    }
    
    .academic-level {
      position: absolute;
      bottom: 10px;
      left: 10px;
      background: rgba(0,0,0,0.7);
      color: white;
      padding: 4px 8px;
      border-radius: 8px;
      font-size: 0.7rem;
    }
    
    .sustainability-indicator {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 5px;
      font-size: 0.8rem;
    }
    
    .sustainability-indicator i {
      color: #4ecdc4;
    }
    
    .boletín-section {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 0;
      text-align: center;
      margin: 40px 0;
    }
    
    .boletín-content h3 {
      font-size: 2rem;
      margin-bottom: 15px;
    }
    
    .boletín-description {
      max-width: 600px;
      margin: 0 auto 25px;
      opacity: 0.9;
    }
    
    .btn-boletin {
      background: white;
      color: #667eea;
      padding: 12px 25px;
      border-radius: 25px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      display: inline-block;
    }
    
    .btn-boletin:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }
    
    .department-info {
      text-align: center;
      padding: 30px 0;
      background: #f8f9fa;
      margin: 30px 0;
      border-radius: 15px;
    }
    
    .department-info h4 {
      color: #1e3c72;
      margin-bottom: 10px;
    }
  </style>
</head>
<body>
  <%- include('cabecera.ejs', { currentPage: 'home' }) %>

  <!-- BANNER TECNOSYSTEM -->
  <section class="tecnosystem-banner">
    <div class="container">
      <div class="banner-content">
        <div class="unh-logo">
          <span>UNH</span>
        </div>
        <div class="banner-text">
          <h2>TECNOSYSTEM 2025</h2>
          <p>Feria Anual de Innovación y Tecnología - Escuela de Ingeniería de Sistemas</p>
        </div>
        <div class="event-date">
          <i class="fas fa-calendar-alt"></i>
          <strong>22 de Julio, 2025</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        Proyectos de <span class="gradient-text">IoT</span>
      </h1>
      <p class="hero-subtitle">
        Descubre proyectos innovadores del Internet de las Cosas desarrollados por estudiantes y profesionales de la Universidad Nacional de Huancavelica
      </p>
      <div class="hero-stats">
        <div class="stat">
          <i class="fas fa-microchip"></i>
          <span class="stat-number" id="totalProyectos"><%= proyectos ? proyectos.length : 0 %></span>
          <span class="stat-label">Proyectos</span>
        </div>
        <div class="stat">
          <i class="fas fa-users"></i>
          <span class="stat-number">40+</span>
          <span class="stat-label">Desarrolladores</span>
        </div>
        <div class="stat">
          <i class="fas fa-award"></i>
          <span class="stat-number">8</span>
          <span class="stat-label">Categorías</span>
        </div>
        <div class="stat">
          <i class="fas fa-globe-americas"></i>
          <span class="stat-number">Huancavelica</span>
          <span class="stat-label">Impacto Regional</span>
        </div>
      </div>
    </div>
    <div class="hero-animation">
      <div class="floating-card">
        <i class="fas fa-wifi"></i>
      </div>
      <div class="floating-card">
        <i class="fas fa-mobile-alt"></i>
      </div>
      <div class="floating-card">
        <i class="fas fa-cloud"></i>
      </div>
    </div>
  </section>

  <!-- INFORMACIÓN DEPARTAMENTO -->
  <section class="department-info">
    <div class="container">
      <h4>Departamento Académico de Ingeniería de Sistemas</h4>
      <p>Promoviendo la innovación tecnológica con impacto regional y nacional</p>
    </div>
  </section>

  <!-- FILTROS Y BÚSQUEDA -->
  <section class="filters-section">
    <div class="container">
      <div class="filters-container">
        <div class="search-bar">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar proyectos por nombre, descripción o integrantes...">
        </div>
        
        <div class="filter-options">
          <button class="filter-btn active" data-filter="all">
            <i class="fas fa-th"></i>
            Todos
          </button>
          <button class="filter-btn" data-filter="arduino">
            <i class="fab fa-arduino"></i>
            Arduino
          </button>
          <button class="filter-btn" data-filter="raspberry">
            <i class="fab fa-raspberry-pi"></i>
            Raspberry Pi
          </button>
          <button class="filter-btn" data-filter="esp32">
            <i class="fas fa-microchip"></i>
            ESP32
          </button>
          <button class="filter-btn" data-filter="sensores">
            <i class="fas fa-thermometer-half"></i>
            Sensores
          </button>
          <button class="filter-btn" data-filter="regional">
            <i class="fas fa-map-marked-alt"></i>
            Impacto Regional
          </button>
        </div>
        
        <!-- FILTROS ADICIONALES TECNOSYSTEM -->
        <div class="additional-filters">
          <button class="filter-btn" data-filter="interdisciplinario">
            <i class="fas fa-users-cog"></i>
            Interdisciplinarios
          </button>
          <button class="filter-btn" data-filter="sostenible">
            <i class="fas fa-leaf"></i>
            Sostenibles
          </button>
          <button class="filter-btn" data-filter="innovartek">
            <i class="fas fa-star"></i>
            InnovarTEK
          </button>
          <button class="filter-btn" data-filter="social">
            <i class="fas fa-heart"></i>
            Impacto Social
          </button>
        </div>
        
        <div class="sort-options">
          <select id="sortSelect">
            <option value="newest">Más recientes</option>
            <option value="oldest">Más antiguos</option>
            <option value="name">Por nombre</option>
            <option value="popular">Más populares</option>
            <option value="impact">Por impacto</option>
            <option value="innovation">Por innovación</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="main-content">
    <div class="container">
      <% if (proyectos && proyectos.length > 0) { %>
        <!-- Grid de proyectos -->
        <div class="projects-grid" id="projectsGrid">
          <% proyectos.forEach((p, index) => { %>
            <article class="project-card" data-category="<%= p.categoria || 'general' %>" data-name="<%= p.nombre.toLowerCase() %>">
              <div class="card-image-container">
                <img class="card-img" 
                     src="/uploads/imagenes/<%= p.imagen %>" 
                     alt="<%= p.nombre %>" 
                     onerror="this.src='/img/default.png'"
                     loading="lazy" />
                <div class="card-overlay">
                  <div class="card-actions">
                    <button class="action-btn like-btn" data-id="<%= p.id %>">
                      <i class="fas fa-heart"></i>
                    </button>
                    <button class="action-btn share-btn" data-id="<%= p.id %>">
                      <i class="fas fa-share-alt"></i>
                    </button>
                    <button class="action-btn bookmark-btn" data-id="<%= p.id %>">
                      <i class="fas fa-bookmark"></i>
                    </button>
                  </div>
                </div>
                <div class="card-badge">
                  <i class="fas fa-microchip"></i>
                  <%= p.categoria || 'IoT' %>
                </div>
                
                <!-- NUEVOS BADGES TECNOSYSTEM -->
                <% if (p.destacado_innovartek) { %>
                  <div class="innovartek-badge">
                    <i class="fas fa-star"></i> InnovarTEK
                  </div>
                <% } %>
                
                <% if (p.nivel_academico) { %>
                  <div class="academic-level">
                    <i class="fas fa-graduation-cap"></i> <%= p.nivel_academico %>
                  </div>
                <% } %>
              </div>
              
              <div class="card-body">
                <div class="card-header">
                  <h3 class="card-title"><%= p.nombre %></h3>
                  <div class="card-rating">
                    <% for(let i = 0; i < 5; i++) { %>
                      <i class="fas fa-star <%= i < (p.rating || 4) ? 'active' : '' %>"></i>
                    <% } %>
                  </div>
                </div>
                
                <p class="card-description">
                  <%= p.descripcion ? p.descripcion.substring(0, 100) + '...' : 'Proyecto innovador de IoT' %>
                </p>
                
                <!-- NUEVOS CAMPOS TECNOSYSTEM -->
                <% if (p.impacto_regional) { %>
                  <div class="project-impact">
                    <i class="fas fa-globe-americas"></i>
                    Impacto Regional: <%= p.impacto_regional %>
                  </div>
                <% } %>
                
                <% if (p.es_interdisciplinario) { %>
                  <div class="sustainability-indicator">
                    <i class="fas fa-users-cog"></i>
                    <span>Proyecto Interdisciplinario</span>
                  </div>
                <% } %>
                
                <% if (p.sostenibilidad) { %>
                  <div class="sustainability-indicator">
                    <i class="fas fa-leaf"></i>
                    <span>Enfoque Sostenible</span>
                  </div>
                <% } %>
                
                <div class="card-meta">
                  <div class="meta-item">
                    <i class="fas fa-users"></i>
                    <span><%= p.integrantes %></span>
                  </div>
                  <div class="meta-item">
                    <i class="fas fa-calendar"></i>
                    <span><%= p.fecha ? new Date(p.fecha).toLocaleDateString('es-ES') : 'Reciente' %></span>
                  </div>
                  <% if (p.docente_asesor) { %>
                    <div class="meta-item">
                      <i class="fas fa-chalkboard-teacher"></i>
                      <span>Asesor: <%= p.docente_asesor %></span>
                    </div>
                  <% } %>
                  <% if (p.ciclo_academico) { %>
                    <div class="meta-item">
                      <i class="fas fa-layer-group"></i>
                      <span>Ciclo <%= p.ciclo_academico %></span>
                    </div>
                  <% } %>
                </div>
                
                <div class="card-tags">
                  <% if (p.tecnologias) { %>
                    <% p.tecnologias.split(',').slice(0, 3).forEach(tech => { %>
                      <span class="tag"><%= tech.trim() %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="tag">IoT</span>
                    <span class="tag">Sensores</span>
                  <% } %>
                  
                  <!-- TAGS ADICIONALES -->
                  <% if (p.enfoque_social) { %>
                    <span class="regional-tag">
                      <i class="fas fa-heart"></i> Social
                    </span>
                  <% } %>
                  
                  <% if (p.region === 'Huancavelica' || p.impacto_regional) { %>
                    <span class="regional-tag">
                      <i class="fas fa-map-marked-alt"></i> Regional
                    </span>
                  <% } %>
                </div>
                
                <div class="card-footer">
                  <div class="card-stats">
                    <span class="stat-item">
                      <i class="fas fa-heart"></i>
                      <%= p.likes || Math.floor(Math.random() * 50) + 5 %>
                    </span>
                    <span class="stat-item">
                      <i class="fas fa-eye"></i>
                      <%= p.views || Math.floor(Math.random() * 200) + 50 %>
                    </span>
                    <% if (p.puntuacion_innovacion) { %>
                      <span class="stat-item">
                        <i class="fas fa-lightbulb"></i>
                        <%= p.puntuacion_innovacion %>/10
                      </span>
                    <% } %>
                  </div>
                  
                  <a href="/proyectos/<%= p.id %>" class="btn btn-primary">
                    <i class="fas fa-arrow-right"></i>
                    Ver Proyecto
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Paginación -->
        <div class="pagination-container">
          <div class="pagination">
            <button class="pagination-btn" id="prevPage" disabled>
              <i class="fas fa-chevron-left"></i>
              Anterior
            </button>
            <div class="pagination-info">
              Página <span id="currentPage">1</span> de <span id="totalPages">1</span>
            </div>
            <button class="pagination-btn" id="nextPage">
              Siguiente
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
      <% } else { %>
        <!-- Estado vacío -->
        <div class="empty-state">
          <div class="empty-icon">
            <i class="fas fa-folder-open"></i>
          </div>
          <h2>No hay proyectos disponibles</h2>
          <p>¡Sé el primero en compartir tu proyecto de IoT para TECNOSYSTEM 2025!</p>
          <a href="/proyectos/subir" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Subir Primer Proyecto
          </a>
        </div>
      <% } %>
    </div>
  </main>

  <!-- SECCIÓN BOLETÍN INNOVARTEK -->
  <!-- <section class="boletín-section">
    <div class="container">
      <div class="boletín-content">
        <h3>
          <i class="fas fa-book-open"></i>
          Boletín Académico InnovarTEK
        </h3>
        <p class="boletín-description">
          Recopilamos y difundimos los proyectos más destacados de cada edición de TECNOSYSTEM, 
          creando un repositorio institucional de iniciativas tecnológicas que inspire a futuras generaciones.
        </p>
        <a href="/innovartek" class="btn-boletin">
          <i class="fas fa-download"></i>
          Descargar Boletín 2024
        </a>
      </div>
    </div>
  </section> -->

  <%- include('pie.ejs') %>

  <!-- Scripts -->
  <script src="/js/app.js"></script>
  
  <!-- Script adicional para funcionalidades TECNOSYSTEM -->
  <script>
    // Funcionalidad adicional para los nuevos filtros
    document.addEventListener('DOMContentLoaded', function() {
      const additionalFilters = document.querySelectorAll('.additional-filters .filter-btn');
      
      additionalFilters.forEach(btn => {
        btn.addEventListener('click', function() {
          const filter = this.dataset.filter;
          
          // Remover clase active de todos los botones
          additionalFilters.forEach(b => b.classList.remove('active'));
          // Agregar clase active al botón clickeado
          this.classList.add('active');
          
          // Aplicar filtro específico
          filterProjects(filter);
        });
      });
      
      function filterProjects(filter) {
        const cards = document.querySelectorAll('.project-card');
        
        cards.forEach(card => {
          let show = false;
          
          switch(filter) {
            case 'interdisciplinario':
              show = card.querySelector('.sustainability-indicator') && 
                     card.querySelector('.sustainability-indicator').textContent.includes('Interdisciplinario');
              break;
            case 'sostenible':
              show = card.querySelector('.sustainability-indicator') && 
                     card.querySelector('.sustainability-indicator').textContent.includes('Sostenible');
              break;
            case 'innovartek':
              show = card.querySelector('.innovartek-badge') !== null;
              break;
            case 'social':
              show = card.querySelector('.regional-tag') && 
                     card.querySelector('.regional-tag').textContent.includes('Social');
              break;
            case 'regional':
              show = card.querySelector('.regional-tag') && 
                     card.querySelector('.regional-tag').textContent.includes('Regional');
              break;
            default:
              show = true;
          }
          
          card.style.display = show ? 'block' : 'none';
        });
      }
      
      // Mejorar la búsqueda para incluir más campos
      const searchInput = document.getElementById('searchInput');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const searchTerm = this.value.toLowerCase();
          const cards = document.querySelectorAll('.project-card');
          
          cards.forEach(card => {
            const title = card.querySelector('.card-title').textContent.toLowerCase();
            const description = card.querySelector('.card-description').textContent.toLowerCase();
            const integrantes = card.querySelector('.meta-item span').textContent.toLowerCase();
            const asesor = card.querySelector('.meta-item:has(i.fa-chalkboard-teacher) span')?.textContent.toLowerCase() || '';
            
            const matches = title.includes(searchTerm) || 
                          description.includes(searchTerm) || 
                          integrantes.includes(searchTerm) || 
                          asesor.includes(searchTerm);
            
            card.style.display = matches ? 'block' : 'none';
          });
        });
      }
    });
  </script>
</body>
</html>